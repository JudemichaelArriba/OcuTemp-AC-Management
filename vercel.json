{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/Ocutemp/browser",
  "framework": null,
  "functions": {
    "api/chat/index.ts": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "font-src 'self' https://*.vercel-storage.com https://vercel-storage.com https://*.vercel.com https://vercel.live https://fonts.gstatic.com https://*.gstatic.com data:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
