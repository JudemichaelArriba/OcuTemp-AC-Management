# Angular/Firebase public application configuration
FIREBASE_API_KEY=replace-with-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_ID=replace-with-sender-id
FIREBASE_APP_ID=replace-with-app-id
SENTRY_DSN=

# Vercel server-only OcuGuide configuration (never expose through environment.ts)
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-gemini-api-key
GROQ_API_KEY=replace-with-groq-api-key
UPSTASH_REDIS_REST_URL=https://replace-with-your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
CHAT_STATE_SECRET=replace-with-base64-encoded-32-byte-random-secret
CHAT_ALLOWED_ORIGINS=http://localhost:4200,https://your-production-domain.example
